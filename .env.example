# Copie para .env.local e preencha. NUNCA commite .env.local.

# URL pública do app (produção: https://seu-dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). A publishable/anon key pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Schema do app dentro do projeto compartilhado
NEXT_PUBLIC_SUPABASE_SCHEMA=conexao

# SOMENTE SERVIDOR (Vercel → Environment Variables, nunca NEXT_PUBLIC_):
# usada apenas por webhooks de pagamento, exclusão de conta e envio de push.
SUPABASE_SERVICE_ROLE_KEY=

# --- Etapas futuras (deixe vazio até configurar) ---
# Guia da Fé (IA)
ANTHROPIC_API_KEY=
# Notificações push (gerar com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seu-dominio
# Pagamentos: segredo/token do webhook do provedor escolhido
KIWIFY_WEBHOOK_TOKEN=
HOTMART_HOTTOK=
CAKTO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Agendador (Vercel Cron) — protege as rotas /api/cron/*
CRON_SECRET=
